{
  "name": "dsh-quota-panel-sidebar",
  "description": "Sidebar-mounted fork of dsh-quota-panel: the provider quota/balance widget lives next to the Settings button at the sidebar foot (collapses into a rail dot when the sidebar folds), cards are left/right-aligned to the Settings trigger, click-away-to-close, and provider rows are always alphabetically sorted by label. Tracked as a true GitHub fork of wenzetan/dsh-quota-panel — the fork's main branch mirrors upstream (one-click Sync fork), this sidebar product lives on the 'sidebar' branch and is rebuilt from src with upstream's toolchain.",
  "version": "0.9.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node scripts/test-page-script.mjs",
    "check": "npm run build && npm test",
    "check:syntax": "node --check lib/index.js && node --check lib/client.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-cordis-client-runner"
      ],
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quota",
    "balance",
    "usage",
    "sidebar",
    "opencode"
  ],
  "license": "MIT",
  "author": "yuzhounh",
  "homepage": "https://github.com/yuzhounh/dsh-quota-panel-sidebar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuzhounh/dsh-quota-panel-sidebar.git"
  }
}